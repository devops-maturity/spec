{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- /* As with sitemapindex.xml: <loc> has to be absolute, and baseURL is "/", so the host
     comes from canonicalBaseURL rather than from Hugo's own permalinks. The hreflang
     alternates are the ones Hugo's built-in template lists, made absolute the same way. */}}
{{- $base := site.Params.canonicalBaseURL }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range where .Pages "Sitemap.Disable" "ne" true }}
  <url>
    <loc>{{ printf "%s%s" $base (strings.TrimPrefix "/" .RelPermalink) }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
    {{- end }}
    {{- if .IsTranslated }}
    {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Lang }}" href="{{ printf "%s%s" $base (strings.TrimPrefix "/" .RelPermalink) }}"/>
    {{- end }}
    {{- end }}
  </url>
  {{- end }}
</urlset>
